#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if ! resolved="$(python3 -B "$project_root/source/scripts/maintenance/project_environment.py" shell)"; then
  exit 75
fi
eval "$resolved"
unset resolved
python_bin="$V7_PYTHON"
if [[ ! -x "$python_bin" ]]; then
  printf '%s\n' "PROJECT_TOOLCHAIN_MISSING: rebuild from the checked locks; see source/docs/maintenance/project-layout.md" >&2
  exit 75
fi
exec "$python_bin" "$project_root/source/scripts/maintenance/ops.py" "$@"
