{
  "name": "qgis-buffer-summary-map-v1",
  "entrypoint": "main",
  "profile": "v7-cwl-p4-v1",
  "documents": {
    "main": {
      "cwlVersion": "v1.2",
      "class": "Workflow",
      "inputs": {
        "vector": "File",
        "buffer_parameters": {
          "type": "record",
          "name": "BufferParameters",
          "fields": [
            {"name": "distance", "type": "double"},
            {"name": "unit", "type": "string"},
            {"name": "output_crs", "type": "string"},
            {"name": "segments", "type": "int"}
          ]
        },
        "summary_parameters": {
          "type": "record",
          "name": "SpatialSummaryParameters",
          "fields": [{"name": "layer_id", "type": "string"}]
        },
        "map_parameters": {
          "type": "record",
          "name": "StaticMapParameters",
          "fields": [
            {"name": "layer_id", "type": "string"},
            {"name": "template_id", "type": "string"},
            {"name": "output_crs", "type": "string"},
            {"name": "title", "type": "string"},
            {"name": "legend", "type": "boolean"},
            {"name": "palette", "type": "string"}
          ]
        }
      },
      "outputs": {
        "buffer": {"type": "File", "outputSource": "buffer/vector"},
        "buffer_manifest": {"type": "File", "outputSource": "buffer/manifest"},
        "buffer_method": {"type": "File", "outputSource": "buffer/method"},
        "summary": {"type": "File", "outputSource": "summary/summary"},
        "summary_method": {"type": "File", "outputSource": "summary/method"},
        "map_image": {"type": "File", "outputSource": "map/image"},
        "map_manifest": {"type": "File", "outputSource": "map/manifest"},
        "map_method": {"type": "File", "outputSource": "map/method"}
      },
      "steps": {
        "buffer": {
          "run": "buffer_operator",
          "in": {"vector": "vector", "parameters": "buffer_parameters"},
          "out": ["vector", "manifest", "method"]
        },
        "summary": {
          "run": "summary_operator",
          "in": {"vector": "buffer/vector", "parameters": "summary_parameters"},
          "out": ["summary", "method"]
        },
        "map": {
          "run": "map_operator",
          "in": {"vector": "buffer/vector", "parameters": "map_parameters"},
          "out": ["image", "manifest", "method"]
        }
      }
    }
  },
  "implementations": {
    "buffer_operator": {
      "kind": "OPERATOR",
      "operator_id": "qgis-buffer",
      "version_id": "1.0.0",
      "execution_binding": {"kind": "LOCAL", "implementation_id": "qgis-buffer-v1"}
    },
    "summary_operator": {
      "kind": "OPERATOR",
      "operator_id": "spatial-vector-summary",
      "version_id": "1.0.0",
      "execution_binding": {"kind": "LOCAL", "implementation_id": "spatial-vector-summary-v1"}
    },
    "map_operator": {
      "kind": "OPERATOR",
      "operator_id": "qgis-static-map",
      "version_id": "1.0.0",
      "execution_binding": {"kind": "LOCAL", "implementation_id": "qgis-static-map-v1"}
    }
  }
}
